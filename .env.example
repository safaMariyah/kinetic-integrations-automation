# Load these with your existing local environment loader. Never commit secrets.
EPICOR_BASE_URL=https://inb-512369.epicor.net/kinetic2027_100/api/v2/odata
EPICOR_COMPANY=EPIC06
EPICOR_USERNAME=
EPICOR_PASSWORD=
EPICOR_API_KEY=
# Approved public CA bundle. The CLI loads this at Node startup; no TLS bypass.
NODE_EXTRA_CA_CERTS=
API_REQUEST_TIMEOUT_MS=90000
POC_CUSTOMER_ID=ECD
POC_EMPLOYEE_ID=
POC_PLANT=MfgSys
POC_FROM_WHSE=CHI
POC_FROM_BIN=00-00-00
POC_TO_WHSE=SHP
POC_TO_BIN=SHP-1
POC_STOCK_QTY=10
POC_SHIP_QTY=8
POC_SHIP_VIA_CODE=F92
POC_PACKAGE_CODE=BOX
POC_WEIGHT=3
POC_UNIT_PRICE=0
POC_TARIFF=1234.56.7899

POC_PART_EXTRAS_FILE=
EPICOR_FREIGHT_URL=http://quickshipweb/EpicorFreightService.svc?regCode=QuickShipDemo
EPICOR_WORKSTATION_ID=PACK
EPICOR_FREIGHT_TIMEOUT=60

QUICKSHIP_REQUEST_DIRECTORY=C:/inetpub/wwwroot/QuickShip/CarrierXMLFile

# Optional tracked target/capability declaration. Blank preserves legacy settings.
TEST_TARGET_PROFILE=
# Required by VAT/Product Code independent reader; provision privately.
QUICKSHIP_BASE_URL=http://quickshipweb
QUICKSHIP_REGISTRATION_CODE=
QUICKSHIP_COMPANY_ID=
QUICKSHIP_STORAGE_STATE=.auth/quickship.json
RUNTIME_CONFIG_FILE=.runtime/config.json
LIVE_LOCK_DIRECTORY=.runtime/locks
# Set only for an authorized full miscellaneous/master-pack run on the exact target:
# <EPICOR_BASE_URL>|<EPICOR_COMPANY>|unique-part|10|7|close-misc|master
MISC_MASTER_AUTHORIZED_TARGET=
