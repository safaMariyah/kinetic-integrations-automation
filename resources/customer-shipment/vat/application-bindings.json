  {
    "id": "BeforeUpdate",
    "actions": [
      {
        "type": "condition",
        "param": {
          "expression": "{TransView.isGridPasting} === true",
          "onSuccess": [
            {
              "type": "row-update",
              "param": [
                {
                  "columns": [
                    {
                      "epBinding": "ShipTo.IsAlternate",
                      "value": false
                    },
                    {
                      "epBinding": "ShipTo.MasterCustNum",
                      "value": 0
                    },
                    {
                      "epBinding": "ShipTo.MasterShipToNum",
                      "value": ""
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "type": "condition",
        "param": {
          "expression": "%dataset.CustCnt.hasChanges% === true",
          "onSuccess": [
            {
              "type": "event-next",
              "value": "UpdateContact",
              "onError": [
                {
                  "type": "return-error"
                }
              ]
            }
          ]
        }
      },
      {
        "type": "condition",
        "param": {
          "expression": "{TransView.NewCustomerShipTo} === true",
          "onSuccess": [
            {
              "type": "condition",
              "param": {
                "expression": "%dataset.Customer.hasChanges% === false",
                "onSuccess": [
                  {
                    "type": "return"
                  }
                ]
              }
            }
          ],
          "onFailure": [
            {
              "type": "condition",
              "param": {
                "expression": "%dataset.Customer.hasChanges% === false",
                "onSuccess": [
                  {
                    "type": "exit"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "type": "condition",
        "param": {
          "expression": "%dataset.Customer.hasChanges% === false",
          "onSuccess": [
            {
              "type": "exit"
            }
          ]
        }
      },
      {
        "type": "event-next",
        "value": "CheckForChangeShipToAddress"
      },
      {
        "type": "event-next",
        "value": "CheckForDuplicateCustomer"
      },
      {
        "type": "event-next",
        "value": "CheckCreditHold"
      },
      {
        "type": "event-next",
        "value": "ChangeMandateReference"
      }
    ]
  },
