  "source_steps": [
    {
      "id": "5",
      "source_id": "prose",
      "text": "Enter Part ID and Description = M1\nSave\nMove to Part / Sites / Warehouses / Warehouse Detail\nPrimary Bin = 00-00-01\nSave\nMove to Part/ Attributes tab\nUOM = IN\nUnit Net Weight = 2.00000 LB\nSave\nExpected Result: None",
      "expectations": []
    },
    {
      "id": "6",
      "source_id": "prose",
      "text": "Quantity adjustment for stock parts\nMaterial Management/Inventory Management/General Operations/ Quantity Adjustment\nPart =M1\nBin = 00-00-01\nQuantity = 10\nReason = Add new part\nClick on the Adjust Button\nExpected Result: None",
      "expectations": []
    },
    {
      "id": "7",
      "source_id": "prose",
      "text": "Create Sales Order(Ord#1)\nGo to Sales Management/Customer Relationship Management/General Operations/Order Entry\nEnter customer ECD and tab out\nSelect Need By date = <Today>\nClick on the ShipTo search\nSelect EDA-A\nSave\nMove to Lines > Detail tab\nClick new\nEnter Part = M1 and tab out\nEnter order quantity = 7\nSave save order number (####)\nGo back to the Details tab. Click Ready to fulfill = true\nSave\nOn actions, select Reserve/Allocate\nSelect both lines and then click allocate by part\nAllocation Process Criteria screen appears.\nClick continue\nAd Hoc Allocation Template screen appear.\nRelease to picking = True\nClick Continue\nMessage appear \"Do you want to print the released items?\"\nClick No\nExpected Result:\n1 Demand record(s) allocated.\n0 Demand record(s) cross docked.\n1 Demand record(s) selected for picking.\n1 Demand record(s) submitted for picking",
      "expectations": [
        {
          "id": "7.1",
          "text": "1 Demand record(s) allocated."
        },
        {
          "id": "7.2",
          "text": "0 Demand record(s) cross docked."
        },
        {
          "id": "7.3",
          "text": "1 Demand record(s) selected for picking."
        },
        {
          "id": "7.4",
          "text": "1 Demand record(s) submitted for picking"
        }
      ]
    },
    {
      "id": "8",
      "source_id": "prose",
      "text": "Go to Material Management/Advanced Material Management/General Operations/Material Request Queue\nRetrieve transactions from today\nSelect the first record displayed (Relate to M1 Part)\nClick process\nClick OK\nExpected Result: None",
      "expectations": []
    },
    {
      "id": "9",
      "source_id": "prose",
      "text": "Create a Pack for Misc Shipment\nService Management/Field Service/General Operations/Miscellaneous Shipment Entry\nClick New Pack\nOn the Name field, click the search button, select East Coast Distribution - Albany\nClick OK\nEnter order number created before (Ord#1)\nShip Via = FedEx Ground\nPackage code = BOX\nSave\nOn the left tree, go to the Line details tab\nClick New Line\nEnter part = M1\nEnter quantity = 7\nSave\nExpected Result: None",
      "expectations": []
    },
    {
      "id": "10",
      "source_id": "prose",
      "text": "Create a Master Pack\nGo to Master Pack Shipment Entry\nMaterial Management/Shipping / Receiving/General Operations/Master Pack Shipment Entry\nClick New Master Pack\nShipment Type = Miscellanous\nFreight Pack IDs Individually = False\nEnter Package code = BOX\nShip via = FedEx Ground\nSave\nOn the left tree, Go to the Line Details tab\nClick on New Pack\nEnter Pack number created on previous steps for Ord#1 and tab out\nSave Master Pack ID.\nExpected Result: not supplied",
      "expectations": []
    }
  ],
