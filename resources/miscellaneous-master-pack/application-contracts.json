  {
    "application": "Erp.UI.MasterpackEntry",
    "evidence_type": "fresh-read-only-application-metadata",
    "sha256": "c1f4ea4a6282b7b99204bd59a1da2f7635d0a9d8b2a339b79c3232db0edbf3c3",
    "events": [
      {
        "id": "ColumnChanged_ShipmentType",
        "trigger": {
          "type": "DataTable",
          "target": "MasterPack",
          "hook": "columnChanged",
          "columns": [
            "ShipmentType"
          ]
        },
        "actions": [
          {
            "type": "condition",
            "param": {
              "expression": "'%value%' !== 'Sales'",
              "onSuccess": [
                {
                  "type": "row-update",
                  "param": [
                    {
                      "columns": [
                        {
                          "epBinding": "Masterpack.OurBank",
                          "value": ""
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "id": "ColumnChanging_DtlPackNum",
        "trigger": {
          "type": "DataTable",
          "target": "MasterPackDtl",
          "hook": "columnChanging",
          "columns": [
            "DtlPackNum"
          ]
        },
        "actions": [
          {
            "type": "row-update",
            "param": [
              {
                "columns": [
                  {
                    "epBinding": "TransView.ProposedDtlPackNum",
                    "value": "%value%"
                  }
                ]
              }
            ]
          },
          {
            "type": "event-next",
            "value": "CallCheckShipStatus",
            "onSuccess": [
              {
                "type": "event-next",
                "value": "CallCartonExists",
                "onSuccess": [
                  {
                    "type": "event-next",
                    "value": "CallCheckCartonInShip",
                    "onSuccess": [
                      {
                        "type": "condition",
                        "param": {
                          "expression": "{TransView.AddingMultipleDtlRecords} === true",
                          "onSuccess": [
                            {
                              "type": "event-next",
                              "value": "SetRowMod",
                              "param": {
                                "dataview": "Masterpack",
                                "RowMod": "U"
                              }
                            },
                            {
                              "type": "event-next",
                              "value": "CallGetShipDetails"
                            }
                          ]
                        }
                      }
                    ],
                    "onError": [
                      {
                        "type": "event-next",
                        "value": "UpdateTransViewContinueProcess",
                        "param": {
                          "continueProcess": false
                        }
                      },
                      {
                        "type": "event-cancel"
                      }
                    ]
                  }
                ],
                "onError": [
                  {
                    "type": "event-next",
                    "value": "UpdateTransViewContinueProcess",
                    "param": {
                      "continueProcess": false
                    }
                  },
                  {
                    "type": "event-cancel"
                  }
                ]
              }
            ],
            "onError": [
              {
                "type": "event-next",
                "value": "UpdateTransViewContinueProcess",
                "param": {
                  "continueProcess": false
                }
              },
              {
                "type": "event-cancel"
              }
            ]
          }
        ]
      },
      {
        "id": "CallCheckShipStatus",
        "actions": [
          {
            "type": "rest-erp",
            "param": {
              "svc": "Erp.BO.MasterPackSvc",
              "svcPath": "CheckShipStatus",
              "requestMethod": "POST",
              "erpRequestMethod": "ErpPostWithDataViewProcessing",
              "methodParameters": [
                {
                  "field": "packNum",
                  "value": "{TransView.ProposedDtlPackNum}"
                },
                {
                  "field": "shipmentType",
                  "value": "{Masterpack.ShipmentType}"
                }
              ],
              "erpRestPostArgs": {
                "requestParamArgs": []
              }
            },
            "onSuccess": [
              {
                "type": "event-next",
                "value": "UpdateTransViewContinueProcess",
                "param": {
                  "continueProcess": true
                }
              },
              {
                "type": "condition",
                "param": {
                  "expression": "'{actionResult.returnObj}' !== 'CLOSED'",
                  "onSuccess": [
                    {
                      "type": "erp-message-handler",
                      "param": {
                        "type": "Slideout",
                        "level": "info",
                        "message": "Pack must be status 'Closed'."
                      }
                    },
                    {
                      "type": "event-next",
                      "value": "UpdateTransViewContinueProcess",
                      "param": {
                        "continueProcess": false
                      }
                    },
                    {
                      "type": "return-error"
                    }
                  ],
                  "onFailure": []
                }
              }
            ],
            "onError": [
              {
                "type": "event-next",
                "value": "UpdateTransViewContinueProcess",
                "param": {
                  "continueProcess": false
                }
              },
              {
                "type": "return-error"
              }
            ]
          }
        ]
      },
      {
        "id": "CallCartonExists",
        "actions": [
          {
            "type": "rest-erp",
            "param": {
              "svc": "Erp.BO.MasterPackSvc",
              "svcPath": "CartonExists",
              "requestMethod": "POST",
              "erpRequestMethod": "ErpPostWithDataViewProcessing",
              "methodParameters": [
                {
                  "field": "packNum",
                  "value": "{TransView.ProposedDtlPackNum}"
                },
                {
                  "field": "shipmentType",
                  "value": "{Masterpack.ShipmentType}"
                }
              ],
              "erpRestPostArgs": {
                "requestParamArgs": []
              }
            },
            "onSuccess": [
              {
                "type": "condition",
                "param": {
                  "expression": "{actionResult.returnObj} === true",
                  "onSuccess": [
                    {
                      "type": "erp-message-handler",
                      "param": {
                        "type": "Slideout",
                        "level": "info",
                        "message": "This Pack was added in a Masterpack."
                      },
                      "onOk": [
                        {
                          "type": "return-error"
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "onError": [
              {
                "type": "return-error"
              }
            ]
          }
        ]
      },
      {
        "id": "CallCheckCartonInShip",
        "actions": [
          {
            "type": "condition",
            "param": {
              "expression": "%MasterpackDtl.count% > 1",
              "onSuccess": [
                {
                  "type": "rest-erp",
                  "param": {
                    "svc": "Erp.BO.MasterPackSvc",
