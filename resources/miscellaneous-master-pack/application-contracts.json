        "id": "PartWhse.PrimBinNum",
        "trigger": {
          "type": "EpBinding",
          "target": "PartWhse.PrimBinNum",
          "hook": "onSearch"
        },
        "actions": [
          {
            "type": "search-show",
            "param": {
              "searchOptions": {
                "selectMode": "SingleSelect",
                "like": "WhseBin.BinNum",
                "searchForm": "default",
                "sortByColumn": "BinNum",
                "useGetRows": false,
                "preLoadSearchFilter": "WarehouseCode = '{PartWhse.WarehouseCode}' AND InActive = 0",
                "validation": {
                  "validateFilter": "BinNum = '%value%'",
                  "errorMessage": "Bin does not exist."
                }
              }
            },
            "onSuccess": [
              {
                "type": "search-value-set",
                "epBinding": "PartWhse.PrimBinNum",
                "value": "actionResult.BinNum"
              },
              {
                "type": "search-value-set",
                "epBinding": "PartWhse.PrimBinNumDescription",
                "value": "actionResult.Description"
              }
            ],
            "onError": [
              {
                "type": "event-cancel"
              }
            ]
          }
        ]
      },
      {
        "id": "clickContextWarehouseSearch",
        "actions": [
          {
            "type": "search-show",
            "param": {
              "searchOptions": {
                "like": "Warehse.WarehouseCode",
                "searchForm": "WarehouseSearchNotInPart",
                "sortByColumn": "",
                "useGetRows": true,
                "valueIn": [
                  {
                    "id": "Plant",
                    "value": "{PartPlant.Plant}"
                  },
                  {
                    "id": "PartNum",
                    "value": "{PartWhse.PartNum}"
                  }
                ]
              }
            },
            "onSuccess": [
              {
                "type": "search-value-set",
                "epBinding": "PartWhse.WarehouseCode",
                "value": "searchResult.WarehouseCode"
              },
              {
                "type": "search-value-set",
                "epBinding": "PartWhse.WarehouseDescription",
                "value": "searchResult.Description"
              }
            ]
          }
        ]
      }
    ]
  },
